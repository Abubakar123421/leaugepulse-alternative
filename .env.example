DISCORD_TOKEN=
DATABASE_PATH=data/leaguebot.sqlite3
BACKUP_DIR=data/backups
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
LOG_LEVEL=INFO
STREAM_POLL_SECONDS=180
# YouTube global searches/day. Increase only after Google approves more quota.
YOUTUBE_SEARCH_DAILY_LIMIT=90
REMINDER_POLL_SECONDS=300


GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=true
AI_DAILY_LIMIT=100

# Optional website API; leave secret blank to keep the bot-only deployment.
# Keep DATABASE_PATH above pointed at the EXISTING production SQLite file.
WEB_API_SECRET=
WEB_GUILD_IDS=
# Only these Discord user IDs may download all-server database backups via web.
WEB_OPERATOR_IDS=
WEB_ORIGIN=https://legacy-bot-three.vercel.app
# Use the port allocated by bot-hosting.net (verify in its panel).
SERVER_PORT=8080
